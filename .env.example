# VIAMA environment template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not,
# so NEVER put a real credential in here.
#
# Everything marked REQUIRED must also be set in the Vercel dashboard
# (Settings -> Environment Variables). Vercel does not upload `.env`.

# ---------------------------------------------------------------------------
# Database - REQUIRED
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:6543/postgres
SUPABASE_DB_PORT=5432

# ---------------------------------------------------------------------------
# Supabase - REQUIRED (PDF storage)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project>.supabase.co

# Service-role key. Full access - never ship to a browser.
SUPABASE_KEY=

# Anon key used for the survey-pdfs bucket. Audit the bucket's RLS policies:
# captain.py uses this key to upload AND delete PDFs.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Flask - REQUIRED
# ---------------------------------------------------------------------------
# Session signing key. Generate with: python -m core.cli gen-secret
# Falls back to the old hardcoded "viama_secret" if unset, which is insecure.
SECRET_KEY=

# ---------------------------------------------------------------------------
# RoadVision video-count sync - REQUIRED for /cron/video-count-sync
# ---------------------------------------------------------------------------
# Bearer token for the upstream counts API. See VIDEO_COUNTS_API.md.
# The app logs a warning when this is within 30 days of expiry.
RV_DASHBOARD_TOKEN=

# Guards /cron/video-count-sync and /api/v1/jobs/tick.
# Vercel Cron also sends this automatically as `Authorization: Bearer`.
CRON_SECRET=

# Optional - defaults to http://34.180.38.204:7001/api/video-counts
# RV_VIDEO_COUNTS_URL=

# Optional kill switch for the on-completion remark check
# (utils/video_count_hook.py), which writes the remark the moment a survey is
# marked completed instead of waiting for the nightly cron. Default is ON.
# Set to 0 to leave remarks entirely to the cron. See VIDEO_COUNTS_API.md 7.1.
# VIDEO_COUNT_ON_COMPLETE=0

# ---------------------------------------------------------------------------
# JSON API (/api/v1) - REQUIRED to use the API at all. See API_GUIDE.md.
# ---------------------------------------------------------------------------
# Signs API bearer tokens. >= 32 chars, must differ from SECRET_KEY.
# Generate with: python -m core.cli gen-secret
API_JWT_SECRET=

# Optional - lets POST /api/v1/auth/token mint the first token over HTTP.
# Prefer `python -m core.cli mint-token` and leave this unset in production.
# API_BOOTSTRAP_SECRET=

# ---------------------------------------------------------------------------
# JSON API - optional tuning. Defaults shown.
# ---------------------------------------------------------------------------
# API_BASE_PATH=/api/v1          # move the API to an unguessable prefix
# API_STEALTH=0                  # 1 = answer unauthenticated calls with a bare 404
# API_REQUIRED=1                 # 0 = boot the portal even if core/ is broken
# API_ENABLED=1                  # 0 = API returns 503
# API_CORS_ORIGINS=              # comma-separated browser origins
# API_TOKEN_CACHE_TTL=30         # seconds a revoked token may still work
# API_TOKEN_VERSION=1            # bump to invalidate every issued token
# AUDIT_RETENTION_DAYS=90
# SYNC_SAFE_LAG_SECONDS=5

# ---------------------------------------------------------------------------
# Webhooks - optional. Defaults shown.
# ---------------------------------------------------------------------------
# WEBHOOK_CAPTURE_ENABLED=1
# WEBHOOK_ENABLED_EVENTS=        # empty = all but assignment.updated; "*" = all
# WEBHOOK_BULK_THRESHOLD=25
# WEBHOOK_MAX_ATTEMPTS=8

# ---------------------------------------------------------------------------
# Google Drive - optional, preferred over token_drive.pickle
# ---------------------------------------------------------------------------
# Service-account JSON (the whole document on one line). When set,
# token_drive.pickle is not read at all and no longer needs to ship in the
# deployment bundle.
#
# This covers DRIVE ONLY. Gmail drafts need a real mailbox, so
# token_gmail.pickle must still ship regardless. Regenerate the two with:
#   python generate_token.py          -> token_drive.pickle
#   python generate_gmail_token.py    -> token_gmail.pickle
# GOOGLE_SA_JSON=
